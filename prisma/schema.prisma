// Prisma schema — see context/architecture-context.md

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserSettings {
  userId              String   @id // Clerk userId
  defaultCurrency     String   @default("EUR")
  defaultReminderDays Int      @default(3)
  email               String? // Email de aviso (sincronizado desde Clerk)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String // Clerk userId
  name            String
  price           Decimal   @db.Decimal(10, 2)
  currency        String    @default("EUR")
  billingCycle    String // "weekly" | "monthly" | "quarterly" | "yearly"
  nextBillingDate DateTime
  reminderDays    Int       @default(3)
  lastNotifiedFor DateTime? // Avoids duplicate notifications in the same cycle
  category        String    @default("General")
  status          String    @default("active") // "active" | "paused" | "cancelled"
  cancelUrl       String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status, nextBillingDate])
}
